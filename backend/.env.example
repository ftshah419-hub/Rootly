# ROOTLY BACKEND ENVIRONMENT CONFIGURATION

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MONGODB CONFIGURATION (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/rootly

# JWT AUTHENTICATION SECRETS
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# EMAIL CONFIGURATION (Nodemailer - SMTP)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Rootly Harvest Network <noreply@rootly.local>"

# CLOUDINARY CONFIGURATION (Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GOOGLE GEMINI AI CONFIGURATION
GEMINI_API_KEY=
